# Copy to `.env` and fill in. `.env` is gitignored — never commit real values,
# and never paste a key into a chat session with any AI tool, including Claude Code.
# The same values go into GitHub repository secrets for the Actions run.
#
# Issuing instructions and notes for each: MANUAL-TASKS.md §1.

# --- Korea ---------------------------------------------------------------

# data.krx.co.kr — KRX Data Marketplace. Free, but LOGIN IS NOW MANDATORY:
# the old 정보데이터시스템 became a members-only marketplace, and every
# investor-flow, short-interest, market-cap and fundamentals endpoint answers
# HTTP 400 "LOGOUT" without a session. Verified 2026-08-03. Walkthrough:
# API-KEYS.md §0. pykrx reads these two variables to log in.
# Register with a native ID/PW — a Naver/Kakao social login has no password
# for pykrx's form login to use.
KRX_ID=
KRX_PW=

# opendart.fss.or.kr — instant issue, free. Daily call limit applies.
DART_API_KEY=

# NOT USED. Korean news comes from outlet RSS (config/news_feeds.yaml), which
# needs no credential. Naver's 검색 API closed to new registrations in 2026 and
# moved to NAVER Cloud Platform; these are kept only for the documented fallback
# in API-KEYS.md §2, and that path uses different variable names entirely.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 한국투자증권 → 트레이딩 → Open API → KIS Developers. Walkthrough: API-KEYS.md §1.
# Requires a securities account; approval is not always instant.
# 모의투자 (paper) is a SEPARATE prior signup — apply for it, then add the mock
# account to the API application via 추가신청하기. Put the MOCK key pair here.
# READ-ONLY USE ONLY — CLAUDE.md forbids calling order/execution/cancellation
# endpoints. Do not select any 주문/계좌 API group on the application form.
KIS_APP_KEY=
KIS_APP_SECRET=

# --- United States -------------------------------------------------------

# fred.stlouisfed.org — instant issue, free.
FRED_API_KEY=

# Pick ONE of Alpaca or Tiingo as the production US quote source (SPEC §3.2).
# Free tier is sufficient at this stage. Leave the unused one blank.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
TIINGO_API_KEY=

# SEC EDGAR needs no key, but does require a descriptive User-Agent with a
# contact address, or requests are refused.
SEC_USER_AGENT=

# --- Delivery ------------------------------------------------------------

# Dedicated sending address + app password. Do not use a primary personal address.
# Channel config (recipient, body format) lives in config/delivery.yaml.
SMTP_PASSWORD=
